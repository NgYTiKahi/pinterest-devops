{
  "name": "pins-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test test/validation.test.js",
    "test:integration": "node --env-file-if-exists=.env --test test/integration.test.js",
    "seed": "node --env-file-if-exists=.env src/seed.js"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "mongoose": "9.10.1",
    "prom-client": "15.1.3"
  }
}
