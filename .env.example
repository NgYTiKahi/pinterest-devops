# Run: node scripts/setup.mjs --local
# Generated passwords contain hex only, safe in MongoDB URIs and dotenv.
COMPOSE_PROJECT_NAME=pins-local
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
MONGO_ROOT_PASSWORD=CHANGE_ME_ROOT
MONGO_APP_PASSWORD=CHANGE_ME_APP
MONGO_EXPORTER_PASSWORD=CHANGE_ME_EXPORTER
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
GRAFANA_ADMIN_USER=admin
FRONTEND_IMAGE=pins-frontend:local
BACKEND_IMAGE=pins-backend:local
